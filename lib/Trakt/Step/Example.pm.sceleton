package Trakt::Step::Example;

use Moose;
extends 'Trakt::Step';


=cut
# Добавьте сюда список deb пакетов которые нужны для запуска этого шага и его целей.
around 'debdeps' => sub {
    my $orig = shift;
    my $self = shift;

    return ($self->$orig(@_), qw(packet1 packet2));
};

=cut


1;


